{
  "name": "marco-90-automation",
  "version": "0.1.0",
  "description": "Custom automation system for Marco Puga — buyer lead pipeline from comment to CRM.",
  "main": "dist/app/webhook.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/src/server.js",
    "dev": "ts-node src/app/webhook.ts",
    "dev:mock": "npm run build && node dist/src/server.js",
    "jobs": "ts-node src/app/jobs.ts",
    "sidecar:start": "cd services/openshorts && python3 app_marco.py",
    "sidecar:dev": "cd services/openshorts && PYTHONUNBUFFERED=1 python3 -u app_marco.py",
    "brivity-migration:inspect": "ts-node scripts/brivity-migration-dry-run.ts --inspect",
    "brivity-migration:dry-run": "ts-node scripts/brivity-migration-dry-run.ts",
    "brivity-migration:apply": "node scripts/brivity-migration-apply.mjs"
  },
  "keywords": [
    "automation",
    "real-estate",
    "brivity",
    "manychat"
  ],
  "license": "UNLICENSED",
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.1.0",
    "@types/node": "^20.10.0",
    "@types/ws": "^8.18.1",
    "typescript": "^5.3.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.80.0",
    "apify-client": "^2.23.4",
    "axios": "^1.13.6",
    "better-sqlite3": "^12.10.0",
    "cors": "^2.8.6",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "form-data": "^4.0.2",
    "http-proxy-middleware": "^3.0.5",
    "multer": "^2.2.0",
    "pdf-lib": "^1.17.1",
    "twilio": "^6.0.2",
    "ws": "^8.21.0"
  }
}
