{
  "manifest_version": 3,
  "name": "Harvey Browser Control",
  "version": "1.9.0",
  "description": "Connect a chosen Chrome tab to Harvey, sign in yourself, and let Harvey work while you watch. Stop control anytime.",
  "permissions": [
    "activeTab",
    "alarms",
    "scripting",
    "sidePanel",
    "storage",
    "tabGroups",
    "tabs",
    "debugger"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Harvey"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "options_page": "popup.html",
  "icons": {
    "128": "icons/icon128.png"
  },
  "minimum_chrome_version": "125",
  "content_scripts": [
    {
      "matches": [
        "https://marco-90-automation.fly.dev/*"
      ],
      "js": [
        "local-bridge.js"
      ],
      "all_frames": true,
      "run_at": "document_start"
    }
  ]
}
