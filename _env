# Analytics — Zernio social analytics provider (section 5).
# Unset = Instagram/Facebook/YouTube tabs report "not connected" and show no
# numbers at all. Nothing is fabricated when this is missing.
#
# NOTE: this is NOT the TikTok DM transport below, despite the same vendor. This
# client points at https://api.zernio.com/v1/analytics/{platform}, which is not
# Zernio's real API host or path shape — it was written against guessed field
# names before anyone had a key. Setting this today turns three honest "waiting
# on the connection" tiles into three red "request failed" tiles, so it stays
# unset until someone rewrites it against the real spec.
# ZERNIO_API_KEY=
# ZERNIO_BASE_URL=https://api.zernio.com

# TikTok DMs — the Zernio inbox transport that replaced ManyChat on that channel.
# Deliberately a DIFFERENT variable from ZERNIO_API_KEY above (the value is the
# same Zernio key) so that turning on TikTok DMs cannot silently arm the unrelated
# analytics client. Unset = /api/zernio/webhook returns 503 and TikTok DMs are dark.
# ZERNIO_DM_API_KEY=
# Shared secret for verifying X-Zernio-Signature (HMAC-SHA256 over the raw body).
# We choose it and register the same value on the Zernio webhook; Zernio never
# generates one. Unset = the webhook refuses every delivery rather than trusting it.
# ZERNIO_WEBHOOK_SECRET=
# Zernio account id for Marco's TikTok (@puga.realtor). Needed on every send.
# ZERNIO_TIKTOK_ACCOUNT_ID=

# Public website lead form → CRM. Same pattern as Mojo: refuse when unset,
# constant-time secret compare, quiet create/enrich, source "Website".
# WEBSITE_WEBHOOK_SECRET=

# TikTok comment agent — replies publicly to comments to earn a DM, because
# TikTok has no comment-to-DM and forbids a business opening a thread.
# THE KILL SWITCH. Set to false to stop every public post immediately; no deploy
# needed, the next comment is skipped and the reason is recorded.
# COMMENT_AGENT_ENABLED=true
# Pacing. These are what keep a 4,400-follower account's reach intact: one video
# can carry 163 comments, and answering them all in an afternoon is the spam
# signature TikTok's moderation looks for. Counted against the durable ledger,
# not memory, so a deploy cannot reset them mid-afternoon.
# COMMENT_AGENT_MAX_PER_HOUR=12
# COMMENT_AGENT_MAX_PER_DAY=60
# COMMENT_AGENT_MIN_SPACING_SEC=25
# Never answer a comment older than this. Sweeping a backlog is what a bot looks
# like, and the agent is meant to look like Marco catching up on today's video.
# COMMENT_AGENT_MAX_COMMENT_AGE_HOURS=48
# COMMENT_AGENT_DB_PATH=   # defaults to /data/comment-agent.db

# Maps — address autocomplete on contact profiles, and geocoding.
# Unset = address fields are plain text boxes and the autocomplete endpoint
# returns nothing. It never guesses an address: a plausible-looking suggestion
# that reaches a provider-less system would get SAVED onto a real contact, and a
# wrong address is worse than an empty one.
# Setting this turns on autocomplete everywhere an address is typed. It does NOT
# by itself put a map on the CMA or the market report — those need coordinates
# on the LISTINGS, and geo.lat is null on all ~32k rows of the SABOR mirror, so
# a map also needs a geocoding backfill with real per-row cost. Separate call.
# MAPS_API_KEY=
# (GOOGLE_MAPS_API_KEY is accepted as an alias.)

